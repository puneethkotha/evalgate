# --- LLM judge (OpenAI-compatible; Groq free tier by default) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, ...
# Claude alt: set base_url to https://api.anthropic.com/v1/ (OpenAI-compat) + an Anthropic key.
JUDGE_MODEL=llama-3.3-70b-versatile

# --- Storage (Postgres + pgvector; matches docker-compose.yml) ---
DATABASE_URL=postgresql://evalgate:evalgate@localhost:5432/evalgate

# --- Calibration + CI gate thresholds ---
ANCHOR_SET_PATH=./anchors.jsonl
MIN_PASS_RATE=0.9
MIN_JUDGE_KAPPA=0.7
